// Diagrama de Implantação (UML) - VitrineOn (E-commerce)
// Gerado a partir de gen_implantacao.py — pode ser editado diretamente.
// Renderizar: dot -Tpng -Gdpi=170 03-implantacao.dot -o ../03-implantacao.png
digraph Implantacao {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.35, ranksep=0.6, newrank=true, compound=true, pad=0.4,
         label=<<B>Diagrama de Implantação (UML) — VitrineOn (E-commerce)</B><BR/><FONT POINT-SIZE="11">AWS · região sa-east-1 (São Paulo) · 2 zonas de disponibilidade · contêineres Docker em ECS Fargate</FONT>>,
         labelloc=t, fontsize=18];
  node  [fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=8, color="#333333", arrowsize=0.6];
  subgraph cluster_devices { label=<<B>Dispositivos dos usuários</B>>; style="rounded,dashed"; color="#888888"; fontsize=12;
  dev_cli [shape=box3d, style=filled, fillcolor="#EAF7EA", color="#2E7D32", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«device»</FONT><BR/><B>Navegador / Celular do Cliente</B><BR/><FONT POINT-SIZE="9">«artifact» loja-web (bundle JS)<BR/>SDK JS do gateway de pagamento</FONT>>];
  dev_adm [shape=box3d, style=filled, fillcolor="#EAF7EA", color="#2E7D32", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«device»</FONT><BR/><B>Computador do Administrador</B><BR/><FONT POINT-SIZE="9">«artifact» painel-admin (bundle JS)</FONT>>];
  }
  subgraph cluster_edge { label=<<B>«cloud» AWS — Borda global</B>>; style="rounded,filled"; fillcolor="#F9F4FC"; color="#6A1B9A"; fontsize=12;
  r53 [shape=box3d, style=filled, fillcolor="#F3EAFB", color="#6A1B9A", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon Route 53</B><BR/><FONT POINT-SIZE="9">DNS · health checks</FONT>>];
  cf [shape=box3d, style=filled, fillcolor="#F3EAFB", color="#6A1B9A", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon CloudFront + AWS WAF</B><BR/><FONT POINT-SIZE="9">CDN (cache de site e imagens)<BR/>regras OWASP · rate limit</FONT>>];
  }
  subgraph cluster_region { label=<<B>«cloud region» AWS sa-east-1 (São Paulo)</B> — dados no Brasil (LGPD)>; style="rounded"; color="#FF9900"; penwidth=2; fontsize=13; margin=16;
    subgraph cluster_entry { label=<<B>Entrada regional</B> (serviços gerenciados)>; style="rounded,filled"; fillcolor="#FBF6FD"; color="#B48CC8"; fontsize=11;
  apigw [shape=box3d, style=filled, fillcolor="#F3EAFB", color="#6A1B9A", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon API Gateway</B><BR/><FONT POINT-SIZE="9">HTTP API · autorizador JWT<BR/>throttling · VPC Link</FONT>>];
  cognito [shape=box3d, style=filled, fillcolor="#F3EAFB", color="#6A1B9A", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon Cognito</B><BR/><FONT POINT-SIZE="9">user pools: clientes / admins<BR/>MFA obrigatório p/ admin</FONT>>];
  s3 [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon S3</B><BR/><FONT POINT-SIZE="9">«artifact» loja-web, painel-admin<BR/>imagens de produtos</FONT>>];
    }
    subgraph cluster_vpc { label=<<B>«VPC» 10.0.0.0/16</B>>; style="rounded,filled"; fillcolor="#F4F9F4"; color="#3F8F3F"; penwidth=1.5; fontsize=12; margin=14;
  alb [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#3F8F3F", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Application Load Balancer (interno)</B><BR/><FONT POINT-SIZE="9">distribui entre as 2 AZs · health check<BR/>roteia /produtos → catálogo · /pagamentos → pagamento · resto → core</FONT>>];
      subgraph cluster_aza { label=<<B>Zona de Disponibilidade A</B> (sa-east-1a)>; style="rounded,dashed"; color="#3F8F3F"; fontsize=11; margin=10;
        subgraph cluster_pub_a { label="Sub-rede pública"; style="rounded"; color="#9CCC9C"; fontsize=9;
  nat [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>NAT Gateway</B><BR/><FONT POINT-SIZE="9">saída para a Internet<BR/>(gateway de pagamento)</FONT>>];
        }
        subgraph cluster_app_a { label="Sub-rede privada — aplicação"; style="rounded"; color="#9CCC9C"; fontsize=9;
  ecs_a [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#2B5C8A", margin="0.1,0.06", label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">«executionEnvironment»</FONT><BR/><B>ECS Fargate — tarefas AZ A</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FB" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>loja-core (imagem Docker)</B><BR/><FONT POINT-SIZE="8">monolito modular · 2 → 10 tarefas</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8DC" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>catalogo-svc (imagem Docker)</B><BR/><FONT POINT-SIZE="8">microsserviço · 2 → 20 tarefas</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FDECEC" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>pagamento-svc (imagem Docker)</B><BR/><FONT POINT-SIZE="8">microsserviço · 2 → 4 tarefas</FONT></TD></TR></TABLE>>];
        }
        subgraph cluster_data_a { label="Sub-rede privada — dados"; style="rounded"; color="#9CCC9C"; fontsize=9;
  aur_w [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Aurora PostgreSQL — Writer</B><BR/><FONT POINT-SIZE="9">«artifact» banco loja_core<BR/>pedidos · estoque · carrinhos · clientes</FONT>>];
  redis_p [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>ElastiCache Redis — primário</B><BR/><FONT POINT-SIZE="9">cache do catálogo</FONT>>];
  os_1 [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>OpenSearch — nó 1</B><BR/><FONT POINT-SIZE="9">«artifact» índice produtos</FONT>>];
        }
      }
      subgraph cluster_azb { label=<<B>Zona de Disponibilidade B</B> (sa-east-1b)>; style="rounded,dashed"; color="#3F8F3F"; fontsize=11; margin=10;
        subgraph cluster_app_b { label="Sub-rede privada — aplicação"; style="rounded"; color="#9CCC9C"; fontsize=9;
  ecs_b [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#2B5C8A", margin="0.1,0.06", label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">«executionEnvironment»</FONT><BR/><B>ECS Fargate — tarefas AZ B</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FB" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>loja-core (imagem Docker)</B><BR/><FONT POINT-SIZE="8">monolito modular · 2 → 10 tarefas</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8DC" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>catalogo-svc (imagem Docker)</B><BR/><FONT POINT-SIZE="8">microsserviço · 2 → 20 tarefas</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FDECEC" BORDER="1" COLOR="#777777"><FONT POINT-SIZE="8" COLOR="#555555">«artifact»</FONT><BR/><B>pagamento-svc (imagem Docker)</B><BR/><FONT POINT-SIZE="8">microsserviço · 2 → 4 tarefas</FONT></TD></TR></TABLE>>];
        }
        subgraph cluster_data_b { label="Sub-rede privada — dados"; style="rounded"; color="#9CCC9C"; fontsize=9;
  aur_r [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Aurora PostgreSQL — Reader</B><BR/><FONT POINT-SIZE="9">réplica · failover automático ≤ 60 s</FONT>>];
  redis_r [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>ElastiCache Redis — réplica</B><BR/><FONT POINT-SIZE="9">failover automático</FONT>>];
  os_2 [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>OpenSearch — nó 2</B><BR/><FONT POINT-SIZE="9">réplica do índice</FONT>>];
        }
      }
    }
    subgraph cluster_managed { label=<<B>Serviços gerenciados de dados, mensageria e operação</B> (Multi-AZ por padrão · acessados via VPC endpoints)>; style="rounded,filled"; fillcolor="#FFFAF0"; color="#E0A040"; fontsize=11;
  ddb [shape=box3d, style=filled, fillcolor="#FDF0E1", color="#B36B00", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon DynamoDB</B><BR/><FONT POINT-SIZE="9">tabela catalogo (produtos/preços)<BR/>tabela pagamentos · on-demand · PITR</FONT>>];
  msg [shape=box3d, style=filled, fillcolor="#ECEFF1", color="#455A64", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon SNS + SQS</B><BR/><FONT POINT-SIZE="9">tópicos: estoque, pagamento<BR/>filas + DLQ por consumidor</FONT>>];
  ses [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon SES</B><BR/><FONT POINT-SIZE="9">e-mails transacionais</FONT>>];
  sec [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Secrets Manager + KMS</B><BR/><FONT POINT-SIZE="9">credenciais e chave do gateway<BR/>criptografia em repouso</FONT>>];
  obs [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>CloudWatch + X-Ray</B><BR/><FONT POINT-SIZE="9">logs, métricas, alarmes<BR/>tracing distribuído</FONT>>];
  ecr [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#333333", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«node»</FONT><BR/><B>Amazon ECR</B><BR/><FONT POINT-SIZE="9">registro de imagens Docker</FONT>>];
    }
  }
  subgraph cluster_ext { label=<<B>Sistemas externos (Internet)</B>>; style="rounded,dashed"; color="#888888"; fontsize=12;
  gw [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#000000", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«external node»</FONT><BR/><B>Gateway de Pagamento</B><BR/><FONT POINT-SIZE="9">API REST + webhooks<BR/>tokenização de cartão · Pix</FONT>>];
  gh [shape=box3d, style=filled, fillcolor="#FFFFFF", color="#000000", margin="0.18,0.08", label=<<FONT POINT-SIZE="9" COLOR="#555555">«external node»</FONT><BR/><B>GitHub + GitHub Actions</B><BR/><FONT POINT-SIZE="9">repositório · CI/CD<BR/>Terraform (infra como código)</FONT>>];
  }

  // ---- Caminhos de comunicação ----
  dev_cli -> r53 [label="DNS"];
  dev_cli -> cf  [label="HTTPS (TLS 1.2+)"];
  dev_adm -> cf  [label="HTTPS"];
  dev_cli -> cognito [label="login OIDC", color="#6A1B9A", fontcolor="#6A1B9A"];
  dev_cli -> gw  [label="HTTPS · tokenização do cartão\n(cartão nunca passa pela VitrineOn)", color="#B71C1C", fontcolor="#B71C1C", style=bold, constraint=false];
  cf -> s3    [label="arquivos estáticos (OAC)"];
  cf -> apigw [label="/api/* HTTPS"];
  apigw -> cognito [label="valida JWT", color="#6A1B9A", fontcolor="#6A1B9A"];
  apigw -> alb [label="VPC Link (privado)"];
  alb -> ecs_a [label="HTTP :8080"];
  alb -> ecs_b [label="HTTP :8080"];

  ecs_a -> aur_w [label="TLS :5432"];
  ecs_b -> aur_w [label="TLS :5432"];
  aur_w -> aur_r [label="replicação", style=dashed, dir=both, color="#B36B00", fontcolor="#B36B00"];
  ecs_a:sw -> redis_p:w [headlabel=":6379", labeldistance=2.5, labelangle=-30];
  redis_p -> redis_r [label="replicação", style=dashed, color="#B36B00", fontcolor="#B36B00"];
  ecs_a:se -> os_1:e [label="HTTPS"];
  os_1 -> os_2 [style=dashed, dir=both, color="#B36B00", label="cluster", fontcolor="#B36B00"];

  ecs_a -> ddb [label="VPC endpoint"];
  ecs_b -> msg [label="VPC endpoint\n(publica/consome eventos)", color="#455A64", fontcolor="#455A64"];
  ecs_b -> ses [label="e-mail", color="#777777", fontcolor="#777777"];
  // ordem vertical (arestas invisíveis só para layout)
  aur_w -> redis_p -> os_1 [style=invis];
  aur_r -> redis_r -> os_2 [style=invis];
  os_1 -> ddb [style=invis]; os_2 -> sec [style=invis];
  ddb -> obs [style=invis]; sec -> ecr [style=invis];
  ecs_a -> nat [label="pagamento-svc", color="#B71C1C", fontcolor="#B71C1C"];
  nat -> gw [label="HTTPS (cobrança)", color="#B71C1C", fontcolor="#B71C1C"];
  gw -> apigw [label="webhook HTTPS", style=dashed, color="#B71C1C", fontcolor="#B71C1C", constraint=false];
  gh -> ecr [label="docker push", constraint=false];
  gh -> alb [label="deploy blue/green (ECS)", style=dashed, color="#555555", constraint=false];

  {rank=same; dev_cli; dev_adm}
  {rank=same; r53; cf}
  {rank=same; ecs_a; ecs_b}
  {rank=same; aur_w; aur_r}
  {rank=same; apigw; cognito; s3}
  {rank=same; alb; nat}
  {rank=same; ddb; msg; ses; sec}
  {rank=same; obs; ecr; gh}
}
